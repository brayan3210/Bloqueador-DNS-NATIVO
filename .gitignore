# Configuracion local (contiene el hash de contrasena; NO subir)
config.json

# Artefactos sin valor para el repo
dns_backup.json
.parar
.parar_proxy

# Certificado del proxy de busquedas (CONTIENE LA CLAVE PRIVADA: NUNCA subir)
proxy_busquedas/mitmproxy/
*.pem
*.cer
*.p12

# Logs del modulo de busquedas
proxy_busquedas/logs/

# Instalador PyInstaller: ignorar temporales de build; el .exe final SI se sube
instalador/build/
instalador/payload/
instalador/*.spec
# Instalador de Python embebido (binario grande; se descarga al construir)
instalador/vendor/

# Python
__pycache__/
*.pyc
*.pyo
